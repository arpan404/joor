{
  "name": "joor",
  "version": "0.0.0-alpha",
  "description": "A high-performance, type-safe backend framework built on web standards.",
  "homepage": "https://github.com/arpan404/joor#readme",
  "bugs": {
    "url": "https://github.com/arpan404/joor/issues"
  },
  "license": "MIT",
  "author": "Joor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arpan404/joor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/runtime.d.ts",
      "import": "./dist/client/runtime.js"
    },
    "./adapters/*": {
      "types": "./dist/runtime/adapters/*.d.ts",
      "import": "./dist/runtime/adapters/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx dev/scripts/build.ts",
    "compile": "tsc --project tsconfig.build.json && tsc-alias",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "setup": "node dev/scripts/setup.js",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "biome lint . && npm run typecheck",
    "lint:fix": "biome lint . --write && oxfmt . --write",
    "prepare": "husky",
    "test": "jest",
    "prepublishOnly": "npm run lint && npm run compile",
    "link": "npm link"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "effect": "^3.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@effect/language-service": "^0.81.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.1",
    "oxfmt": "^0.47.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "biome lint --write",
      "oxfmt --write"
    ]
  }
}
