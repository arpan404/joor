{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "release/**",
    "node_modules/**",
    ".joor/**",
    "**/.joor/**",
    ".joor-trusted/**",
    "**/.joor-trusted/**",
    ".cache/**",
    ".turbo/**",
    ".vercel/**",
    "dev/playgrounds/**",
    ".src/**/*.js",
    ".src/**/*.d.ts"
  ],
  "insertFinalNewline": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5"
}
